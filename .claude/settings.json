{
  "permissions": {
    "deny": [
      "Read(./archive/**)",
      "Read(./demo/landing/**)",
      "Read(./demo/clinic-backend/index.html)",
      "Read(./demo/clinic-backend/data.json)",
      "Read(./tmrw_harness.egg-info/**)",
      "Read(./frontend/node_modules/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud_setup.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
